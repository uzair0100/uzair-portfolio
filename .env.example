# EmailJS Configuration
# Get these from: https://dashboard.emailjs.com/admin/account

# Email Service ID (found in Email Services)
# Example: service_abc123def456
EMAILJS_SERVICE_ID=your_service_id_here

# Email Template ID (found in Email Templates)
# Example: template_xyz789abc123
EMAILJS_TEMPLATE_ID=your_template_id_here

# Public Key (found in Account > API Keys)
# Example: VWeA_NMi3haSG5ANp1234567890
EMAILJS_PUBLIC_KEY=your_public_key_here

# Private Key (found in Account > API Keys)
# IMPORTANT: Never commit this! Only use in .env.local or deployment secrets
# Example: 9AQ59AcLzL8RobMqtrQ7j1234567890
EMAILJS_PRIVATE_KEY=your_private_key_here
